<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>zcdebug</AssemblyName>
    <RootNamespace>ZeroCompany.DebugCli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The Lua mod is embedded so a single-file zcdebug can install it. -->
  <ItemGroup>
    <EmbeddedResource Include="mod\ZcDebug\Scripts\main.lua" LogicalName="mod/ZcDebug/Scripts/main.lua" />
    <EmbeddedResource Include="mod\ZcDebug\enabled.txt" LogicalName="mod/ZcDebug/enabled.txt" />
  </ItemGroup>

</Project>
