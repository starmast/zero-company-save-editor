<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZeroCompany.App.ViewModels"
             x:Class="ZeroCompany.App.Views.UpgradesView"
             x:DataType="vm:UpgradesViewModel">
  <StackPanel Spacing="12">
    <!-- tabs -->
    <ItemsControl ItemsSource="{Binding Tabs}" HorizontalAlignment="Center">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:TabViewModel">
          <Button Classes="tab" Classes.active="{Binding IsActive}" Command="{Binding Command}" Content="{Binding Label}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Classes="panel" Padding="14,8" IsVisible="{Binding NeedsGameData}">
      <TextBlock Classes="amber" TextWrapping="Wrap"
                 Text="Den Levels, costs and prerequisites aren't known yet, so upgrades are shown in tier order and every Available upgrade can be started. Open the Game data tab and extract your game data to see the real levels." />
    </Border>

    <!-- toolbar -->
    <Border Classes="panel" Padding="14,8">
      <WrapPanel>
        <CheckBox IsChecked="{Binding AlsoExpedite}" Content="Also expedite upgrades I start" Margin="0,0,16,0" VerticalAlignment="Center" />
        <Button Content="{Binding QueueAllLabel}" Command="{Binding QueueAllCommand}" IsEnabled="{Binding CanQueueAll}" Margin="0,2,8,2" />
        <Button Content="{Binding ExpediteAllLabel}" Command="{Binding ExpediteAllCommand}" IsEnabled="{Binding CanExpediteAll}" Margin="0,2,8,2" />
        <Button Content="Clear queue" Command="{Binding ClearQueueCommand}" IsEnabled="{Binding CanClearQueue}" Margin="0,2,16,2" />
        <TextBlock Classes="mute small" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                   Text="Starting works like the game's Build button; the game finishes upgrades at the next turn change. No cost is charged." />
      </WrapPanel>
    </Border>

    <Grid ColumnDefinitions="*,12,340">
      <!-- timeline -->
      <Border Classes="panel">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
          <StackPanel MinWidth="620">
            <Border Classes="hairline" Height="40">
              <Grid ColumnDefinitions="124,*">
                <TextBlock Classes="caps ice" Text="DEN LEVEL" VerticalAlignment="Center" Margin="12,0,0,0" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Axis}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DenAxisCellViewModel">
                      <Panel>
                        <TextBlock Text="{Binding Text}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Classes="caps" Classes.mute="{Binding IsFuture}" Classes.ice="{Binding IsPast}" />
                        <TextBlock Text="◆" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Classes="amber" IsVisible="{Binding IsCurrent}" />
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
            <TextBlock Classes="mute" Margin="14,12" Text="No upgrades in this category." IsVisible="{Binding NoRows}" />
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:UpgradeRowViewModel">
                  <Border Classes="hairline" Height="58">
                    <Grid ColumnDefinitions="124,*">
                      <TextBlock Text="{Binding Label}" Classes="h2" VerticalAlignment="Center" Margin="12,0,6,0" TextWrapping="Wrap" />
                      <Border Grid.Column="1" Height="2" Background="#2a3b4e" Margin="30,0" VerticalAlignment="Center" />
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:UpgradeCellViewModel">
                            <ItemsControl ItemsSource="{Binding Nodes}" HorizontalAlignment="Center" VerticalAlignment="Center">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UpgradeNodeViewModel">
                                  <Button Classes="nodebtn" Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Tooltip}"
                                          Width="{Binding BoxSize}" Height="{Binding BoxSize}">
                                    <Panel>
                                      <Border Classes="node" Classes.done="{Binding IsDone}" Classes.building="{Binding IsBuilding}"
                                              Classes.locked="{Binding IsLocked}" Classes.sel="{Binding IsSelected}" Classes.queued="{Binding IsQueued}"
                                              Width="{Binding Size}" Height="{Binding Size}">
                                        <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                                      </Border>
                                      <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Foreground="{StaticResource CreamBrush}" Classes.dark="{Binding IsDone}" />
                                    </Panel>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <StackPanel Grid.Column="2" Spacing="12">
        <!-- build slots -->
        <Border Classes="panel">
          <StackPanel>
            <Border Classes="panelh"><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="caps h2" Text="BUILD SLOTS" /><TextBlock Grid.Column="1" Classes="mute small" Text="{Binding SlotsHeading}" VerticalAlignment="Center" /></Grid></Border>
            <TextBlock Classes="mute" Margin="14,10" Text="Nothing is being built." IsVisible="{Binding NoSlots}" />
            <ItemsControl ItemsSource="{Binding Slots}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BuildSlotViewModel">
                  <Button Classes="link" Command="{Binding SelectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <TextBlock Classes="caps amber" Text="BUILDING" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="2" Background="{StaticResource AmberBrush}" Padding="6,0" IsVisible="{Binding HasRemaining}">
                        <TextBlock Text="{Binding Remaining}" Foreground="Black" FontWeight="Bold" />
                      </Border>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- detail -->
        <Border Classes="panel">
          <StackPanel>
            <TextBlock Classes="mute" Margin="14,12" Text="Select an upgrade on the timeline." IsVisible="{Binding NoSelection}" />
            <StackPanel IsVisible="{Binding HasSelection}">
              <Border Classes="hairline" Padding="14,10">
                <StackPanel>
                  <TextBlock Classes="title" FontSize="24" Text="{Binding DetailTitle}" TextWrapping="Wrap" />
                  <TextBlock Classes="caps ice" Text="{Binding DetailStatus}" />
                </StackPanel>
              </Border>
              <StackPanel Margin="14,10" Spacing="8">
                <TextBlock Text="{Binding DetailDescription}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                <TextBlock Classes="ice h2" Text="{Binding DetailCost}" IsVisible="{Binding HasCost}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DetailDen}" TextWrapping="Wrap" IsVisible="{Binding HasDen}" Classes.mute="{Binding !DenWarn}" Classes.amber="{Binding DenWarn}" />
                <TextBlock Classes="bad" Text="{Binding DetailReason}" TextWrapping="Wrap" IsVisible="{Binding HasReason}" />
              </StackPanel>
              <StackPanel Margin="14,0,14,12" Orientation="Horizontal" Spacing="8">
                <ContentControl Content="{Binding StartToggle}" />
                <ContentControl Content="{Binding ExpediteToggle}" />
                <TextBlock Classes="mute small" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260" IsVisible="{Binding AlreadyExpedited}"
                           Text="Already expedited — finishes at the next turn change." />
                <TextBlock Classes="ok caps" Text="✓ COMPLETED" IsVisible="{Binding IsCompleted}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
