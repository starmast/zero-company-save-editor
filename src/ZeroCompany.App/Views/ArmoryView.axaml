<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZeroCompany.App.ViewModels"
             xmlns:c="using:ZeroCompany.App.Controls"
             x:Class="ZeroCompany.App.Views.ArmoryView"
             x:DataType="vm:ArmoryViewModel">
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <ItemsControl ItemsSource="{Binding Tabs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TabViewModel">
            <Button Classes="tab" Classes.active="{Binding IsActive}" Command="{Binding Command}" Content="{Binding Label}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBox Grid.Column="1" Width="230" PlaceholderText="Search items…" Text="{Binding Filter}" />
    </Grid>

    <TextBlock Classes="mute" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" />

    <ItemsControl ItemsSource="{Binding Visible}" IsVisible="{Binding ShowOwned}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ArmoryCardViewModel">
          <Border Classes="panel" Width="372" Margin="0,0,12,12" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="h2" FontSize="19" Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Classes="caps ice small" Text="{Binding Meta}" />
                <TextBlock Classes="mute" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" HorizontalAlignment="Right">
                <TextBlock Classes="caps mute small" Text="OWNED" HorizontalAlignment="Right" />
                <Panel IsVisible="{Binding UseStepper}"><c:StepperField DataContext="{Binding Count}" /></Panel>
                <Panel IsVisible="{Binding UseNumber}"><c:NumField DataContext="{Binding Count}" Width="90" /></Panel>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="mute small" TextWrapping="Wrap" IsVisible="{Binding ShowAdd}"
               Text="Items the game defines, including ones you never got (for example the rewards of a meditation you did not choose). + queues a new copy; Apply to save adds it to the inventory. The save keeps each copy as its own entry, so two of an item are two entries. Weapon mods and utility items only; resources already have an editable amount. Not yet tried in the game." />

    <ItemsControl ItemsSource="{Binding VisibleAdd}" IsVisible="{Binding ShowAdd}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AddItemCardViewModel">
          <Border Classes="panel" Width="372" Margin="0,0,12,12" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="h2" FontSize="19" Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Classes="caps ice small" Text="{Binding Meta}" />
                <TextBlock Classes="caps mute small" Text="{Binding Owned}" />
                <TextBlock Classes="mute" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" HorizontalAlignment="Right">
                <TextBlock Classes="caps mute small" Text="ADD" HorizontalAlignment="Right" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="-" Command="{Binding Minus}" Width="32" />
                  <TextBlock Text="{Binding QueuedText}" Width="34" TextAlignment="Center" VerticalAlignment="Center" />
                  <Button Content="+" Command="{Binding Plus}" Width="32" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
