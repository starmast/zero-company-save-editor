<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZeroCompany.App.ViewModels"
             xmlns:c="using:ZeroCompany.App.Controls"
             x:Class="ZeroCompany.App.Views.ArmoryView"
             x:DataType="vm:ArmoryViewModel">
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <ItemsControl ItemsSource="{Binding Tabs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TabViewModel">
            <Button Classes="tab" Classes.active="{Binding IsActive}" Command="{Binding Command}" Content="{Binding Label}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBox Grid.Column="1" Width="230" PlaceholderText="Search items…" Text="{Binding Filter}" />
    </Grid>

    <TextBlock Classes="mute" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" />

    <ItemsControl ItemsSource="{Binding Visible}" IsVisible="{Binding ShowOwned}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ArmoryCardViewModel">
          <Border Classes="panel" Width="372" Margin="0,0,12,12" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="h2" FontSize="19" Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Classes="caps ice small" Text="{Binding Meta}" />
                <TextBlock Classes="mute" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" HorizontalAlignment="Right">
                <TextBlock Classes="caps mute small" Text="OWNED" HorizontalAlignment="Right" />
                <Panel IsVisible="{Binding UseStepper}"><c:StepperField DataContext="{Binding Count}" /></Panel>
                <Panel IsVisible="{Binding UseNumber}"><c:NumField DataContext="{Binding Count}" Width="90" /></Panel>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Classes="panel" Padding="14,10" IsVisible="{Binding ShowAddTools}">
      <StackPanel Spacing="8">
        <WrapPanel>
          <StackPanel Margin="0,0,12,6" Spacing="2">
            <TextBlock Classes="caps mute small" Text="SHOW" />
            <ComboBox Width="210" ItemsSource="{Binding GroupChoices}" SelectedItem="{Binding SelGroup, Mode=TwoWay}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:GroupChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Margin="0,0,12,6" Spacing="2">
            <TextBlock Classes="caps mute small" Text="TIER" />
            <ComboBox Width="130" ItemsSource="{Binding TierChoices}" SelectedItem="{Binding SelTier, Mode=TwoWay}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:GroupChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Margin="0,0,12,6" Spacing="2">
            <TextBlock Classes="caps mute small" Text="RARITY" />
            <ComboBox Width="150" ItemsSource="{Binding RarityChoices}" SelectedItem="{Binding SelRarity, Mode=TwoWay}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:GroupChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Margin="0,0,12,6" Spacing="2">
            <TextBlock Classes="caps mute small" Text="SORT BY" />
            <ComboBox Width="190" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SelSort, Mode=TwoWay}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:GroupChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Margin="0,16,0,6" Orientation="Horizontal" Spacing="16">
            <CheckBox Content="Never owned only" IsChecked="{Binding NeverOwnedOnly, Mode=TwoWay}" />
            <CheckBox Content="Queued only" IsChecked="{Binding QueuedOnly, Mode=TwoWay}" />
          </StackPanel>
        </WrapPanel>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="mute" Text="{Binding AddSummary}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Clear filters" Command="{Binding ClearFilters}" />
        </Grid>
      </StackPanel>
    </Border>

    <TextBlock Classes="mute small" TextWrapping="Wrap" IsVisible="{Binding ShowAdd}"
               Text="Items the game defines, including ones you never got (for example the rewards of a meditation you did not choose). Search matches every word you type, in any order. + queues a new copy; Apply to save adds it to the inventory. The save keeps each copy as its own entry, so two of an item are two entries. Weapon mods and utility items only; resources already have an editable amount. Not yet tried in the game." />

    <ItemsControl ItemsSource="{Binding VisibleAdd}" IsVisible="{Binding ShowAdd}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AddItemCardViewModel">
          <Border Classes="panel" Width="372" Margin="0,0,12,12" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="h2" FontSize="19" Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Classes="caps ice small" Text="{Binding Meta}" TextWrapping="Wrap" />
                <TextBlock Classes="caps mute small" Text="{Binding Owned}" />
                <TextBlock Classes="mute" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" HorizontalAlignment="Right">
                <TextBlock Classes="caps mute small" Text="ADD" HorizontalAlignment="Right" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="−" Command="{Binding Minus}" Width="34" Height="34" Padding="0" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                  <TextBlock Text="{Binding QueuedText}" Width="34" TextAlignment="Center" VerticalAlignment="Center" />
                  <Button Content="+" Command="{Binding Plus}" Width="34" Height="34" Padding="0" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
