<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZeroCompany.App.ViewModels"
             xmlns:c="using:ZeroCompany.App.Controls"
             x:Class="ZeroCompany.App.Views.CombatView"
             x:DataType="vm:CombatViewModel">
  <StackPanel Spacing="12">
    <Border Classes="panel" IsVisible="{Binding NoCombat}">
      <TextBlock Classes="mute" Margin="14,12" TextWrapping="Wrap"
                 Text="This save is not a combat save. Open a combat autosave (for example Autosave_EncounterStart) from the Saves tab to edit units in a fight." />
    </Border>

    <StackPanel Spacing="12" IsVisible="{Binding HasCombat}">
      <Border Classes="panel">
        <StackPanel>
          <Border Classes="panelh">
            <TextBlock Classes="caps h2" Text="{Binding Summary}" VerticalAlignment="Center" />
          </Border>
          <TextBlock Classes="mute small" Margin="14,8,14,12" TextWrapping="Wrap"
                     Text="Edit every unit on the map and the mission objectives, one tab at a time. Health and the other numbers are each unit's saved base values. The game caps Health at the unit's real maximum when it loads the save, so a high Health value is a full heal (it will not stay at, say, 999). Changes are queued; apply them from the bar below." />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,Auto">
        <ItemsControl ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TabViewModel">
              <Button Classes="tab" Classes.active="{Binding IsActive}" Command="{Binding Command}" Content="{Binding Label}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Heal allies to full" Command="{Binding SquadHeal}" IsVisible="{Binding ShowAllyActions}" />
          <Button Content="Enemies to 1 HP" Command="{Binding EnemiesTo1Hp}" IsVisible="{Binding ShowEnemyActions}" />
          <Button Content="Restore scenery" Command="{Binding RestoreScenery}" IsVisible="{Binding ShowDestructibles}" />
        </StackPanel>
      </Grid>

      <ItemsControl ItemsSource="{Binding Units}" IsVisible="{Binding ShowUnits}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:UnitCardViewModel">
            <Border Classes="panel" Width="430" Margin="0,0,12,12">
              <StackPanel>
                <Border Classes="panelh">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Classes="caps h2" Text="{Binding Name}" />
                      <TextBlock Classes="caps bad" Text="DEAD" IsVisible="{Binding IsDeadNow}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ContentControl Grid.Column="1" Content="{Binding Dead}" />
                  </Grid>
                </Border>
                <StackPanel Margin="12,8" Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Team (experimental)" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding TeamChoices}" SelectedItem="{Binding SelectedTeam, Mode=TwoWay}" Width="130" />
                  </Grid>
                  <TextBlock Classes="amber small" TextWrapping="Wrap" IsVisible="{Binding TeamChanged}"
                             Text="Ally = you control it. Friendly AI = friendly to you but moved by the game (rescued VIPs, allied fighters); the safest way to turn an enemy to your side. Switches team tag, friendly flag, the tag inside the unit and its behaviour, as the game does. A unit turned Enemy also copies the AI area and faction tags and the action-point refresh values of the nearest enemy. It moves to the other tab after you apply." />
                  <TextBlock Classes="bad small" TextWrapping="Wrap" IsVisible="{Binding TeamWarning}"
                             Text="This unit's class is built for a player to control. In testing, a hero switched to Enemy or Friendly AI loaded fine but skipped its turn, because the AI has no abilities for it. Enemies and other AI-class units switch fine." />
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FieldRowViewModel">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                          <c:NumField Grid.Column="1" DataContext="{Binding Field}" Width="110" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="Auto,*,*,*" IsVisible="{Binding HasPosition}">
                    <TextBlock Text="Position X Y Z" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <c:NumField Grid.Column="1" DataContext="{Binding X}" Margin="0,0,4,0" />
                    <c:NumField Grid.Column="2" DataContext="{Binding Y}" Margin="0,0,4,0" />
                    <c:NumField Grid.Column="3" DataContext="{Binding Z}" />
                  </Grid>

                  <Expander Header="{Binding StatsHeader}">
                    <ItemsControl ItemsSource="{Binding Stats}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FieldRowViewModel">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <TextBlock Classes="mute small" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Tip}" />
                            <c:NumField Grid.Column="1" DataContext="{Binding Field}" Width="110" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>

                  <Expander Header="{Binding EffectsHeader}">
                    <StackPanel Spacing="4">
                      <ItemsControl ItemsSource="{Binding Effects}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:CombatEffectRowViewModel">
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="mute small" Text="{Binding Detail}" />
                              </StackPanel>
                              <Panel Grid.Column="1" IsVisible="{Binding HasStacks}" Margin="0,0,8,0">
                                <c:NumField DataContext="{Binding Stacks}" Width="70" />
                              </Panel>
                              <ContentControl Grid.Column="2" Content="{Binding Remove}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl ItemsSource="{Binding QueuedCopies}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:QueuedCopyViewModel">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                              <TextBlock Classes="amber small" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                              <Button Grid.Column="1" Content="Undo" Command="{Binding Undo}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasChoices}" Margin="0,4,0,0">
                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                  PlaceholderText="Copy an effect from another unit..." HorizontalAlignment="Stretch" Margin="0,0,8,0">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EffectChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="Add" Command="{Binding AddEffect}" />
                      </Grid>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="panel" IsVisible="{Binding ShowSpawnSet}">
        <StackPanel>
          <Border Classes="panelh"><TextBlock Classes="caps h2" Text="MISSION SETTINGS" /></Border>
          <Border Padding="14,10" IsVisible="{Binding HasSpawnSet}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="title" FontSize="16" Text="Enemy threat" />
                <TextBlock Classes="mute small" TextWrapping="Wrap"
                           Text="The threat tier a mission draws its enemy units from when an encounter starts. Higher tiers bring tougher units. Sets marked (other faction) would bring that faction's units: experimental." />
                <TextBlock Classes="ice small" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding SpawnSet.Note}" />
              </StackPanel>
              <ComboBox Grid.Column="1" Width="190" Margin="12,0,0,0" ItemsSource="{Binding SpawnSet.Choices}" SelectedItem="{Binding SpawnSet.Selected, Mode=TwoWay}" VerticalAlignment="Center">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GroupChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>
          <Border Classes="hairline" Padding="14,10" IsVisible="{Binding HasTurn}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="title" FontSize="16" Text="Turn structure" />
                <TextBlock Classes="mute small" TextWrapping="Wrap"
                           Text="This mission is a three-way battle: Enemy2 is its own hostile team and fights Enemy. Switching to Standard removes the three-way structure; Enemy2 units would then be put back on Enemy by the game. Shown only in three-way battles; adding it to an ordinary mission was tried and does not work." />
              </StackPanel>
              <ComboBox Grid.Column="1" Width="190" Margin="12,0,0,0" ItemsSource="{Binding Turn.Choices}" SelectedItem="{Binding Turn.Selected, Mode=TwoWay}" VerticalAlignment="Center">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GroupChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="panel" IsVisible="{Binding ShowReinforcements}">
        <StackPanel>
          <Border Classes="panelh"><TextBlock Classes="caps h2" Text="INCOMING WAVES" /></Border>
          <Grid ColumnDefinitions="*,Auto" Margin="14,10" IsVisible="{Binding HasRound}">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Current round" />
              <TextBlock Classes="mute small" TextWrapping="Wrap" Text="The round the fight is on. The game saves it and reads it back on load (a copy set to round 8 loaded as round 8). Reinforcement waves are scheduled by round, but how a change here affects them has not been tried in the game yet." />
              <TextBlock Classes="mute small" Text="{Binding Round.SavedText}" />
            </StackPanel>
            <NumericUpDown Grid.Column="1" Width="130" Minimum="1" Maximum="{Binding Round.Maximum}" Increment="1" FormatString="0" Value="{Binding Round.Value, Mode=TwoWay}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="mute" Margin="14,10" Text="No reinforcement waves are queued right now." IsVisible="{Binding NoWaves}" />
          <ItemsControl ItemsSource="{Binding Waves}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WaveRowViewModel">
                <Border Classes="hairline" Padding="14,8">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Classes="title" FontSize="18" Text="{Binding Title}" />
                      <TextBlock Classes="mute small" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="190" Margin="8,0" ItemsSource="{Binding Group.Choices}" SelectedItem="{Binding Group.Selected, Mode=TwoWay}" VerticalAlignment="Center">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GroupChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center" IsVisible="{Binding HasRound}">
                      <TextBlock Classes="mute small" Text="Round" VerticalAlignment="Center" />
                      <c:NumField DataContext="{Binding Round}" Width="70" />
                    </StackPanel>
                    <ContentControl Grid.Column="3" Content="{Binding Cancel}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="panel" IsVisible="{Binding ShowReinforcements}">
        <StackPanel>
          <Border Classes="panelh"><TextBlock Classes="caps h2" Text="WAVE DEFINITIONS" /></Border>
          <ItemsControl ItemsSource="{Binding Configs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WaveConfigRowViewModel">
                <Border Classes="hairline" Padding="14,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Classes="title" FontSize="18" Text="{Binding Title}" />
                      <TextBlock Classes="mute small" Text="{Binding Detail}" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="mute small" Text="Delay (rounds)" VerticalAlignment="Center" />
                          <c:NumField DataContext="{Binding Delay}" Width="60" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="mute small" Text="May spawn (-1 = no limit)" VerticalAlignment="Center" />
                          <c:NumField DataContext="{Binding TimesToSpawn}" Width="60" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="mute small" Text="Already triggered" VerticalAlignment="Center" />
                          <c:NumField DataContext="{Binding TimesTriggered}" Width="60" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="190" ItemsSource="{Binding Group.Choices}" SelectedItem="{Binding Group.Selected, Mode=TwoWay}" VerticalAlignment="Center">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GroupChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="panel" IsVisible="{Binding ShowReinforcements}">
        <StackPanel>
          <Border Classes="panelh"><TextBlock Classes="caps h2" Text="TRIGGERS" /></Border>
          <ItemsControl ItemsSource="{Binding Triggers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TriggerRowViewModel">
                <Border Classes="hairline" Padding="14,8">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="caps amber" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0" />
                    <Panel Grid.Column="2" IsVisible="{Binding HasFlag}" VerticalAlignment="Center">
                      <ContentControl Content="{Binding Toggle}" />
                    </Panel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="mute small" Margin="14,8,14,12" TextWrapping="Wrap"
                     Text="Waves arrive at the round shown (rounds count up through the fight; the current round is the number above). Cancel pushes a wave to round 999. A group can only be swapped for one this encounter already uses. A definition's 'May spawn' limits how often it fires (-1 = no limit); 'Already triggered' counts how often it has. Triggers can be switched off once they have fired. Tried in the game: swapping a definition's group and changing its delay carried through, and the wave that arrived used the new group. Apply to a copy first." />
        </StackPanel>
      </Border>

      <Border Classes="panel" IsVisible="{Binding ShowHazards}">
        <StackPanel>
          <Border Classes="panelh"><TextBlock Classes="caps h2" Text="FIRE ZONES" /></Border>
          <ItemsControl ItemsSource="{Binding Hazards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HazardRowViewModel">
                <Border Classes="hairline" Padding="14,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Classes="title" FontSize="18" Text="{Binding Title}" />
                      <TextBlock Classes="mute small" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Panel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                      <c:NumField DataContext="{Binding TurnsLeft}" Width="90" />
                    </Panel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="mute small" Margin="14,8,14,12" TextWrapping="Wrap"
                     Text="Turns a fire keeps burning. They start near 9999, so they effectively never go out; set a low number to let one burn out. Not tried in the game yet." />
        </StackPanel>
      </Border>

      <Border Classes="panel" IsVisible="{Binding ShowDestructibles}">
        <StackPanel DataContext="{Binding Scenery}" x:DataType="vm:SceneryPanelViewModel">
          <Border Classes="panelh"><TextBlock Classes="caps h2" Text="DESTRUCTIBLE SCENERY" /></Border>
          <Border Padding="14,10">
            <StackPanel Spacing="8">
              <WrapPanel>
                <TextBox Width="260" Margin="0,0,12,6" PlaceholderText="Search props…" Text="{Binding Search, Mode=TwoWay}" />
                <ComboBox Width="170" Margin="0,0,12,6" ItemsSource="{Binding ConditionChoices}" SelectedItem="{Binding SelCondition, Mode=TwoWay}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:GroupChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Margin="0,0,12,6" Content="Queued only" IsChecked="{Binding QueuedOnly, Mode=TwoWay}" />
                <Button Margin="0,0,8,6" Content="Clear filters" Command="{Binding ClearFilters}" />
              </WrapPanel>
              <WrapPanel>
                <Button Margin="0,0,8,6" Content="{Binding DestroyShownText}" Command="{Binding DestroyShown}" />
                <Button Margin="0,0,8,6" Content="{Binding RestoreShownText}" Command="{Binding RestoreShown}" />
                <Button Margin="0,0,8,6" Content="Clear queued" Command="{Binding ClearQueued}" />
              </WrapPanel>
              <TextBlock Classes="mute" Text="{Binding Summary}" TextWrapping="Wrap" />
              <TextBlock Classes="mute" Text="Nothing matches." IsVisible="{Binding IsEmpty}" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Visible}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PropRowViewModel">
                <Border Classes="hairline" Padding="14,6">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Classes="title" FontSize="16" Text="{Binding Title}" />
                      <TextBlock Classes="mute small" Text="{Binding Area}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="mute" Text="{Binding ConditionText}" Margin="0,0,12,0" Width="70" VerticalAlignment="Center" />
                    <Panel Grid.Column="2" Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding HasHealth}">
                      <c:NumField DataContext="{Binding Health}" Width="70" />
                    </Panel>
                    <TextBlock Grid.Column="3" Classes="mute" Text="{Binding Max}" Width="48" VerticalAlignment="Center" />
                    <ContentControl Grid.Column="4" Content="{Binding Destroy}" IsVisible="{Binding CanDestroy}" Margin="8,0,0,0" MinWidth="110" VerticalAlignment="Center" />
                    <ContentControl Grid.Column="5" Content="{Binding Restore}" IsVisible="{Binding CanRestore}" Margin="8,0,0,0" MinWidth="110" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="mute small" Margin="14,8,14,12" TextWrapping="Wrap"
                     Text="Every cover, crate, railing and other prop the save tracks (hundreds in a real level), not only the ones already hit. Destroy wrecks a prop when the save loads; Restore brings a destroyed or damaged one back. The save marks a prop destroyed separately from its health, so changing health alone does not wreck or rebuild it. The buttons act on every prop the search and filters match. Tried in the game: destroyed barricades vanished (they are hidden and no longer collide, so units can walk through the gap)." />
        </StackPanel>
      </Border>

      <Border Classes="panel" IsVisible="{Binding ShowTimers}">
        <StackPanel>
          <Border Classes="panelh"><TextBlock Classes="caps h2" Text="TIMERS" /></Border>
          <ItemsControl ItemsSource="{Binding Timers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TimerRowViewModel">
                <Border Classes="hairline" Padding="14,8">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Classes="title" FontSize="18" Text="{Binding Title}" />
                      <TextBlock Classes="mute small" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Panel Grid.Column="1" IsVisible="{Binding HasRemaining}" Margin="12,0,6,0" VerticalAlignment="Center">
                      <c:NumField DataContext="{Binding Remaining}" Width="80" />
                    </Panel>
                    <TextBlock Grid.Column="2" Classes="mute" Text="{Binding Total}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="mute small" Margin="14,8,14,12" TextWrapping="Wrap"
                     Text="Turns left on a countdown. Raise it to give yourself more turns before the objective it guards fails." />
        </StackPanel>
      </Border>

      <Border Classes="panel" IsVisible="{Binding ShowObjectives}">
        <StackPanel>
          <Border Classes="panelh"><TextBlock Classes="caps h2" Text="OBJECTIVES" /></Border>
          <ItemsControl ItemsSource="{Binding Objectives}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ObjectiveRowViewModel">
                <Border Classes="hairline" Padding="14,8">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Classes="title" FontSize="18" Text="{Binding Title}" />
                      <TextBlock Classes="mute small" Text="{Binding Detail}" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding Counters}" IsVisible="{Binding HasCounters}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FieldRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                              <TextBlock Classes="mute small" Text="{Binding Label}" VerticalAlignment="Center" />
                              <c:NumField DataContext="{Binding Field}" Width="64" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="caps" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0"
                               Classes.amber="{Binding IsLive}" Classes.ice="{Binding IsDone}" />
                    <Panel Grid.Column="2" IsVisible="{Binding CanEdit}" VerticalAlignment="Center">
                      <ContentControl Content="{Binding Toggle}" />
                    </Panel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="mute small" Margin="14,8,14,12" TextWrapping="Wrap"
                     Text="Objectives only change the saved status. A normal completion also fires follow-on steps (cutscenes, the next objective, reinforcements); those are not triggered by flipping the status. Tried in the game: marking an interact objective Succeeded greyed it out, but its counter stayed at 0 of 1 and the next objective did not start. Check the result in the game and keep the backup. Objectives marked Not started have not begun yet and are left alone, because the game adds a lot of state when it starts one." />
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
