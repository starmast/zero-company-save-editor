<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZeroCompany.App.ViewModels"
             x:Class="ZeroCompany.App.Controls.NumField"
             x:DataType="vm:EditableField">
  <!-- DataContext is an EditableField. Typed text is applied as soon as it is a valid number inside the limits. -->
  <TextBox Classes="num"
           Classes.changed="{Binding IsChanged}"
           Classes.invalid="{Binding IsInvalid}"
           Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
           ToolTip.Tip="{Binding Label}" />
</UserControl>
