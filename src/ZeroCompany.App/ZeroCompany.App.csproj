<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ZeroCompanyEditor</AssemblyName>
    <RootNamespace>ZeroCompany.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Release builds are published as one self-contained exe per OS, with the native libraries (Skia, HarfBuzz, ANGLE, Magick) next
       to it. The bundle is not compressed and the libraries are not packed into it: unpacking DLLs to the temp folder and loading them
       from there is what made malware sandboxes (VirusTotal, as run by Nexus Mods) flag the editor. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Magick.NET-Q16-HDRI-AnyCPU" Version="15.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroCompany.Core\ZeroCompany.Core.csproj" />
    <ProjectReference Include="..\ZeroCompany.GameData\ZeroCompany.GameData.csproj" />
    <ProjectReference Include="..\ZeroCompany.Sdk\ZeroCompany.Sdk.csproj" />
  </ItemGroup>

</Project>
