# --- Runtime data created by the app (contains your save files and conversions of them)
backups/
cache/
*.sav
*.sav.tmp
*.tmp

# --- Your save files. The folder exists so the app can list "project copy" saves; keep contents local.
saves/*
!saves/.gitkeep

# --- Extracted game content (copyrighted; never publish) and tool downloads
gamedata/
*.usmap
*.uasset
*.uexp
*.ubulk
*.pak
*.utoc
*.ucas

# --- third-party binaries fetched at run time
tools/extract/*.dll
*.dll
*.pdb

# --- Editor / tool / OS files
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
.env
*.log

# --- .NET build output
bin/
obj/
*.user
.vs/
artifacts/

# --- stray Python bytecode (the app is C# now; never commit these)
__pycache__/
*.py[cod]
.venv/
